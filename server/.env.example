# Copiar a .env y ajustar. La PC de escritorio usa este mismo .env para levantar todo.

DATABASE_URL=postgresql://planta:planta@localhost:5432/planta
MQTT_HOST=localhost
MQTT_PORT=1883

JWT_SECRET=cambia-esto-por-algo-largo-y-aleatorio
JWT_EXPIRE_MINUTES=480

# Usuarios sembrados por seed.py (solo se usan la primera vez que se corre el seed).
# Un solo secreto por usuario, numérico: se teclea igual en el ESP32 (teclado
# 4x4, solo dígitos) y se escribe igual en el formulario web.
SEED_USUARIO_1_NOMBRE=operador1
SEED_USUARIO_1_SECRETO=1234
SEED_USUARIO_2_NOMBRE=operador2
SEED_USUARIO_2_SECRETO=5678

# --- Cámara ESP32-S3-CAM (las dos versiones vienen apagadas) ---
# Token compartido con la placa (CAMARA_TOKEN en firmware/esp32-cam-*/include/config.h).
CAMARA_TOKEN=cambia-el-token-de-la-camara

# Versión A: el login por teclado exige PIN + rostro. Enrolar las caras desde el
# dashboard (/rostro) ANTES de prenderlo, o nadie podrá entrar por el teclado.
# Necesita los modelos: python ml/descargar_modelos.py
# Solo actúa si además hay una placa con el firmware de rostro conectada; si no,
# el teclado entra solo con PIN y queda una alerta camara_offline.
LOGIN_ROSTRO=false
# ROSTRO_UMBRAL=0.363
# ROSTRO_VENTANA_S=15
# ROSTRO_MAX_RECHAZOS=3

# Versión B: cada caja que ve el sensor dispara una foto que clasifica un
# modelo scikit-learn. Ver docs/camara-color.md
CAMARA_COLOR=false

# --- Webcam USB en esta misma laptop, en vez de la ESP32-S3-CAM ---
# Con cualquiera de las dos en true el servidor saca la foto el mismo con
# OpenCV: no hace falta placa, WiFi propio de la camara, MQTT ni
# CAMARA_TOKEN para esa version. Ver docs/camara-rostro.md.
ROSTRO_WEBCAM=false
COLOR_WEBCAM=false
# Indice de cv2.VideoCapture: 0 suele ser la webcam integrada de la laptop,
# 1 la primera USB. Si no es la correcta, probar cv2.VideoCapture(i, cv2.CAP_DSHOW)
# con distintos indices y ver cual devuelve un frame de la camara esperada.
WEBCAM_INDICE=0

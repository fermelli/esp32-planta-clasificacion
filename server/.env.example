# Copiar a .env y ajustar. La PC de escritorio usa este mismo .env para levantar todo.

DATABASE_URL=postgresql://planta:planta@localhost:5432/planta
MQTT_HOST=localhost
MQTT_PORT=1883

JWT_SECRET=cambia-esto-por-algo-largo-y-aleatorio
JWT_EXPIRE_MINUTES=480

# Usuarios sembrados por seed.py (solo se usan la primera vez que se corre el seed).
# Un solo secreto por usuario, numérico: se teclea igual en el ESP32 (teclado
# 4x4, solo dígitos) y se escribe igual en el formulario web.
SEED_USUARIO_1_NOMBRE=operador1
SEED_USUARIO_1_SECRETO=1234
SEED_USUARIO_2_NOMBRE=operador2
SEED_USUARIO_2_SECRETO=5678
